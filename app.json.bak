{
    "expo":  {
                 "name":  "MzansiReels",
                 "slug":  "mzansireels",
                 "version":  "1.0.0",
                 "orientation":  "portrait",
                 "icon":  "./assets/icon.png",
                 "userInterfaceStyle":  "dark",
                 "assetBundlePatterns":  [
                                             "**/*"
                                         ],
                 "ios":  {
                             "supportsTablet":  true,
                             "bundleIdentifier":  "com.yourname.mzansireels"
                         },
                 "android":  {
                                 "adaptiveIcon":  {
                                                      "foregroundImage":  "./assets/icon.png",
                                                      "backgroundColor":  "#000000"
                                                  },
                                 "package":  "com.yourname.mzansireels",
                                 "permissions":  [
                                                     "android.permission.RECORD_AUDIO"
                                                 ]
                             },
                 "web":  {
                             "favicon":  "./assets/favicon.png"
                         },
                 "plugins":  [
                                 "expo-web-browser",
                                 "expo-video",
                                 [
                                     "expo-image-picker",
                                     {
                                         "photosPermission":  "MzansiReels needs your photos so you can upload videos and a profile picture.",
                                         "cameraPermission":  "MzansiReels needs your camera so you can record videos."
                                     }
                                 ],
                                 "expo-status-bar",
                                 "expo-splash-screen"
                             ],
                 "extra":  {
                               "eas":  {
                                           "projectId":  "9d349ea3-5b11-4196-af34-70a03548789f"
                                       }
                           }
             }
}
