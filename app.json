{
    "expo":  {
                 "name":  "MzansiReels",
                 "slug":  "mzansireels",
                 "scheme":  "mzansireels",
                 "version":  "1.0.0",
                 "orientation":  "portrait",
                 "icon":  "./assets/icon.png",
                 "userInterfaceStyle":  "dark",
                 "assetBundlePatterns":  [
                                             "**/*"
                                         ],
                 "ios":  {
                             "supportsTablet":  true,
                             "bundleIdentifier":  "com.yourname.mzansireels"
                         },
                 "android":  {
                                 "adaptiveIcon":  {
                                                      "foregroundImage":  "./assets/icon.png",
                                                      "backgroundColor":  "#000000"
                                                  },
                                 "package":  "com.yourname.mzansireels",
                                 "permissions":  [
                                                     "android.permission.RECORD_AUDIO"
                                                 ]
                             },
                 "web":  {
                             "favicon":  "./assets/favicon.png",
                             "bundler":  "metro"
                         },
                 "plugins":  [
                                 "expo-web-browser",
                                 "expo-video",
                                 [
                                     "expo-image-picker",
                                     {
                                         "photosPermission":  "MzansiReels needs your photos so you can upload videos and a profile picture.",
                                         "cameraPermission":  "MzansiReels needs your camera so you can record videos."
                                     }
                                 ],
                                 "expo-status-bar",
                                 [
                                     "expo-media-library",
                                     {
                                         "photosPermission":  "MzansiReels needs access to your photos to save videos to your library.",
                                         "savePhotosPermission":  "Allow MzansiReels to save videos to your library."
                                     }
                                 ],
                                 [
                                     "expo-splash-screen",
                                     {
                                         "backgroundColor":  "#000000",
                                         "image":  "./assets/splash.png",
                                         "resizeMode":  "contain"
                                     }
                                 ],
                                 "expo-sharing",
                                 "@react-native-community/datetimepicker"
                             ],
                 "extra":  {
                               "eas":  {
                                           "projectId":  "9d349ea3-5b11-4196-af34-70a03548789f"
                                       }
                           },
                 "experiments":  {
                                     "baseUrl":  "/MzansiReels"
                                 }
             },
    "experiments":  {
                        "baseUrl":  "/MzansiReels"
                    }
}
